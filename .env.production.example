ENVIRONMENT=production
PORT=8102
DATABASE_URL=postgresql://oysyn_mobile_prod:<PRODUCTION_DB_PASSWORD>@127.0.0.1:5432/oysyn_mobile_prod
REDIS_URL=redis://127.0.0.1:6379/2

JWT_SECRET_KEY=<PRODUCTION_JWT_SECRET_MIN_32_CHARS>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

OYSYN_CORE_API_URL=<CORE_PRODUCTION_INTERNAL_API_URL>
OYSYN_CORE_SERVICE_TOKEN=<CORE_PRODUCTION_SERVICE_TOKEN>
OYSYN_CORE_API_TIMEOUT=30

CORS_ALLOWED_ORIGINS=
# Optional update prompt configuration
APP_UPDATE_ANDROID_LATEST_VERSION=1.0.8
APP_UPDATE_ANDROID_LATEST_BUILD=9
APP_UPDATE_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=asia.oysyn.mobile
APP_UPDATE_IOS_LATEST_VERSION=1.0.8
APP_UPDATE_IOS_LATEST_BUILD=9
